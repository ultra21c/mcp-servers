{
  "name": "daum-search-mcp",
  "version": "1.0.0",
  "description": "Daum Search API integration for Model Context Protocol - 다음 검색을 MCP로 사용하세요",
  "license": "MIT",
  "author": {
    "name": "ultra21c",
    "url": "https://github.com/ultra21c"
  },
  "homepage": "https://github.com/ultra21c/mcp-servers/tree/main/daum-search",
  "repository": {
    "type": "git",
    "url": "https://github.com/ultra21c/mcp-servers.git",
    "directory": "src/daum-search"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "daum",
    "kakao",
    "search",
    "api",
    "server",
    "claude",
    "claude-desktop",
